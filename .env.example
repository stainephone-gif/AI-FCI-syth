# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=123456:replace-me

# Провайдер моделей: anthropic | gigachat | openai
MODEL_PROVIDER=anthropic

# Claude API (MODEL_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# GigaChat (MODEL_PROVIDER=gigachat): Authorization key из личного кабинета developers.sber.ru.
# Scope: GIGACHAT_API_PERS для физлица, GIGACHAT_API_B2B или GIGACHAT_API_CORP для организации.
# VERIFY_SSL=false, пока не установлен корневой сертификат Минцифры; иначе true.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=false

# Любой OpenAI-совместимый API (MODEL_PROVIDER=openai): Qwen, Kimi, OpenRouter и т. п.
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Имена моделей. Пусто = по умолчанию для провайдера
# (anthropic: claude-haiku-4-5 / claude-opus-5; gigachat: GigaChat-2 / GigaChat-2-Max).
# Для openai задать обязательно. Список доступных: python -m app.cli models
RANK_MODEL=
DRAFT_MODEL=

# Telegram user id редакторов через запятую (узнать у @userinfobot)
EDITOR_IDS=111111111,222222222

# Чат редакции (приватная группа с ботом). Отрицательное число для групп.
EDITOR_CHAT_ID=-1001234567890

# Канал, куда публикуем. @username или числовой id.
CHANNEL_ID=@your_channel

# База. По умолчанию SQLite в ./data, в проде Postgres из docker-compose.
DATABASE_URL=sqlite+aiosqlite:///./data/syth.db

# Часовой пояс расписания
TZ=Europe/Moscow

# Расписание (cron: минута час * * *)
COLLECT_CRON=0 6 * * *
DIGEST_CRON=0 9 * * *

# Пометка сгенерированного контента в конце каждого поста (HTML Telegram). Пока пусто.
POST_FOOTER=

# Карточки: рендер через Chromium. Пусто = браузер из установки Playwright.
CARDS_ENABLED=true
CHROMIUM_PATH=

LOG_LEVEL=INFO
