# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=123456:replace-me

# Ключ Claude API
ANTHROPIC_API_KEY=sk-ant-replace-me

# Telegram user id редакторов через запятую (узнать у @userinfobot)
EDITOR_IDS=111111111,222222222

# Чат редакции (приватная группа с ботом). Отрицательное число для групп.
EDITOR_CHAT_ID=-1001234567890

# Канал, куда публикуем. @username или числовой id.
CHANNEL_ID=@your_channel

# База. По умолчанию SQLite в ./data, в проде Postgres из docker-compose.
DATABASE_URL=sqlite+aiosqlite:///./data/syth.db

# Часовой пояс расписания
TZ=Europe/Moscow

# Расписание (cron: минута час * * *)
COLLECT_CRON=0 6 * * *
DIGEST_CRON=0 9 * * *

# Пометка сгенерированного контента в конце каждого поста (HTML Telegram). Пока пусто.
POST_FOOTER=

# Карточки: рендер через Chromium. Пусто = браузер из установки Playwright.
CARDS_ENABLED=true
CHROMIUM_PATH=

LOG_LEVEL=INFO
